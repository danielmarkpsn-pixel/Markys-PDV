# MARKYS PDV — configuração inicial da conta Master
# MODELO: este arquivo é apenas uma referência para preencher a configuração no Windows.
# NÃO coloque senha nem código de recuperação neste arquivo ou no GitHub.
# Copie os parâmetros para o ambiente protegido do computador servidor.

MARKYS_MODE=shared

# Pode preencher estes dois campos com os dados que deseja usar:
MARKYS_MASTER_USERNAME=Daniel Marques
MARKYS_MASTER_NAME=DanMarkys

# Defina estes dois segredos SOMENTE no Windows servidor, fora do GitHub:
MARKYS_MASTER_PASSWORD=0123456789
MARKYS_MASTER_RECOVERY_CODE=Dj@10042026

# Requisitos:
# - Usuário: 3 a 64 caracteres.
# - Senha: 10 a 256 caracteres; use uma senha forte e exclusiva.
# - Código de recuperação: mínimo de 16 caracteres; guarde offline em local seguro.
# - A conta é criada na primeira inicialização do modo compartilhado.
# - Depois de criada, alterar estas variáveis não redefine a conta existente.
